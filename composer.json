{
    "name": "studiodevs/laravel-cookie-consent",
    "description": "Baner zgody na cookies dla aplikacji Laravel (Blade), oparty na orestbida/cookieconsent v3: kategorie zgód, Google Analytics po zgodzie, blokowanie osadzonych iframe'ów do czasu zgody.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cookies", "cookie-consent", "gdpr", "rodo"],
    "authors": [
        {
            "name": "Mateusz Rycombel",
            "email": "mateusz@studiodevs.pl",
            "homepage": "https://studiodevs.pl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "StudioDevs\\CookieConsent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StudioDevs\\CookieConsent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StudioDevs\\CookieConsent\\CookieConsentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
